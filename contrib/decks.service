# Optional (Linux): keep Decks running as a systemd user service.
# Install: see "Run it at login" in README.md. __APP__ is filled in then.
[Unit]
Description=Decks
After=network.target

[Service]
WorkingDirectory=__APP__
ExecStart=/usr/bin/env python3 __APP__/server.py
Restart=on-failure

[Install]
WantedBy=default.target
